# ============================================================
# UnityCare Platform — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Backend (FastAPI) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD_HERE@localhost:5432/unitycare
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate-a-secure-random-string-at-least-32-chars
ENCRYPTION_KEY=generate-another-secure-random-string-at-least-32-chars
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend (Next.js) ─────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: OIDC ─────────────────────────────────────────
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── Optional: OpenTelemetry ─────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=
