# ============================================================
# UnityCare Platform — Environment Variables
# Current stack: FastAPI (Python) + PostgreSQL + Next.js
# ============================================================

# ── Backend (FastAPI) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unitycare
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production-32bytes!
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend (Next.js) ─────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: OIDC ─────────────────────────────────────────
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── Optional: OpenTelemetry ─────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=
