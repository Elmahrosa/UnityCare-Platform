# === Required (must change these) ===
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD_HERE@localhost:5432/unitycare
JWT_SECRET=generate-a-secure-random-string-at-least-32-chars
ENCRYPTION_KEY=generate-another-secure-random-string-at-least-32-chars

# === Redis (optional, rate limiting) ===
REDIS_URL=redis://localhost:6379/0

# === Optional ===
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
FHIR_BASE_URL=http://localhost:8000/fhir
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Environment ===
ENVIRONMENT=development
DEBUG=false
