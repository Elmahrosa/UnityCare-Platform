# === Optional ===
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
FHIR_BASE_URL=http://localhost:8000/fhir
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Environment ===
ENVIRONMENT=development
DEBUG=true
